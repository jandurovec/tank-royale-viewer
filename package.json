{
  "name": "tank-royale-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --run",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit && npm run typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.playwright.json",
    "lint": "eslint src tests playwright.config.ts vite.config.ts vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "flag-icons": "^7.5.0",
    "openskill": "^5.0.1",
    "pixi.js": "^8.19.0",
    "ts-trueskill": "^5.1.0"
  }
}
