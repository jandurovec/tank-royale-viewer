{
  "name": "tank-royale-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --run",
    "pretest:e2e": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:all": "npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc --noEmit && npm run typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.playwright.json",
    "lint": "eslint src tests playwright.config.ts vite.config.ts vitest.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.19.15",
    "eslint": "^10.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.14",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "flag-icons": "^7.5.0",
    "openskill": "^4.1.0",
    "pixi.js": "^8.16.0",
    "ts-trueskill": "^5.1.0"
  }
}
